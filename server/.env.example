# ==========================================
# JRonix VPN Backend Configuration Template
# ==========================================

PORT=3000

# WireGuard Server Settings (Your Ubuntu VPS)
WG_SERVER_HOST=YOUR_UBUNTU_VPS_PUBLIC_IP
WG_SERVER_PORT=51820

# Server Public Key (from `cat /etc/wireguard/server_public.key` on VPS)
WG_SERVER_PUBLIC_KEY=REPLACE_WITH_YOUR_SERVER_PUBLIC_KEY

# DNS servers assigned to clients
WG_DNS=1.1.1.1, 8.8.8.8

# WireGuard network interface on VPS (default: wg0)
WG_INTERFACE=wg0
